# Runtime
NODE_ENV=development

# Ports
BACKEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOCALSTACK_PORT=4566
FRONTEND_PORT=19003
ADMINER_PORT=8081
REDIS_COMMANDER_PORT=8082

# Postgres
POSTGRES_DB=hell_auth_dev
POSTGRES_USER=hell_auth_user
POSTGRES_PASSWORD=change_me_dev_postgres

# Redis
REDIS_PASSWORD=change_me_dev_redis

# Auth & Crypto
JWT_SECRET=change_me_dev_jwt_secret_with_at_least_32_chars
JWT_EXPIRES_IN=60m
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# AWS / LocalStack
AWS_ENDPOINT=http://localstack:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_SERVICES=s3,sqs,sns,secretsmanager,cloudwatch
LOCALSTACK_DEBUG=1

# Monitoring / Logs
PROMETHEUS_ENABLED=true
LOG_LEVEL=debug

# HTTP / Security
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080
TRUST_PROXY=false

# Frontend (optional profile)
REACT_NATIVE_PACKAGER_HOSTNAME=localhost
API_BASE_URL=http://localhost:3000

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_dev_grafana
