# Configurações do ambiente
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Banco de dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=hell_auth_user
DB_PASSWORD=hell_auth_password
DB_NAME=hell_auth_dev
DATABASE_URL=postgresql://hell_auth_user:hell_auth_password@localhost:5432/hell_auth_dev

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=hell_auth_redis_password
REDIS_URL=redis://:hell_auth_redis_password@localhost:6379

# JWT
JWT_SECRET=hell_auth_jwt_secret_dev_very_long_and_secure_key_2025
JWT_EXPIRES_IN=60m
JWT_REFRESH_EXPIRES_IN=7d

# Criptografia
ENCRYPTION_KEY=hell_auth_encryption_key_32_chars_2025

# AWS LocalStack (desenvolvimento)
AWS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Monitoramento
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
SENTRY_DSN=

# Logs
LOG_LEVEL=debug

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080,http://localhost:8081

# Segurança
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
