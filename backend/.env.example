# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Ports
BACKEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOCALSTACK_PORT=4566
FRONTEND_PORT=19003
ADMINER_PORT=8081
REDIS_COMMANDER_PORT=8083

# Postgres
DB_HOST='localhost'
DB_PORT=5432
DB_USER='hell_auth_user'
DB_PASSWORD='hell_auth_password'
DB_NAME='hell_auth_dev'
DATABASE_URL='postgresql://hell_auth_user:hell_auth_password@localhost:5432/hell_auth_dev'

# Redis
REDIS_HOST='localhost'
REDIS_PORT=6379
REDIS_PASSWORD='hell_auth_redis_password'
REDIS_URL='redis://:hell_auth_redis_password@localhost:6379'

# Auth & Crypto
JWT_SECRET=change_me_dev_jwt_secret_with_at_least_32_chars
JWT_EXPIRES_IN=60m
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=557694902939F5B97613148205A4BD5C1586E3DDEC3CD28E7EB82ED063DD2D3F

# AWS / LocalStack
AWS_ENDPOINT=http://localstack:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_SERVICES=s3,sqs,sns,secretsmanager,cloudwatch
LOCALSTACK_DEBUG=1

# ------------------------------------------------------------------------------
# User-owned cloud connections via OAuth
# These are used when the user chooses to connect their own Google Drive
# account from the mobile app.
# ------------------------------------------------------------------------------

GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=https://creepy-eusebio-septically.ngrok-free.dev/api/backup/user-cloud-connections/oauth/callback

# Monitoring / Logs
PROMETHEUS_ENABLED=true
LOG_LEVEL=debug

# HTTP / Security
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080,http://localhost:8081,http://localhost:5173
TRUST_PROXY=false

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW='1 minute'

# Frontend (optional profile)
REACT_NATIVE_PACKAGER_HOSTNAME=localhost
API_BASE_URL=http://localhost:3000

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_dev_grafana

# Logs
LOG_LEVEL=debug
