{
  "name": "hell-authenticator-backend",
  "version": "1.0.0",
  "description": "Backend API para o Hell Authenticator",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "migrate": "ts-node src/migrations/run-migrations.ts",
    "migrate:generate": "ts-node src/migrations/generate-migration.ts",
    "seed": "ts-node src/scripts/seed.ts",
    "docker:build": "docker build -t hell-auth-backend .",
    "docker:run": "docker run -p 3000:3000 hell-auth-backend"
  },
  "keywords": [
    "authenticator",
    "2fa",
    "totp",
    "fastify",
    "typescript",
    "postgresql"
  ],
  "author": "Hell Authenticator Team",
  "license": "MIT",
  "dependencies": {
    "fastify": "^4.24.3",
    "@fastify/cors": "^8.4.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^8.0.0",
    "@fastify/swagger": "^8.12.0",
    "@fastify/swagger-ui": "^2.1.0",
    "typeorm": "^0.3.17",
    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "reflect-metadata": "^0.1.13",
    "uuid": "^9.0.1",
    "zod": "^3.22.4",
    "aws-sdk": "^2.1490.0",
    "prom-client": "^15.0.0",
    "fastify-plugin": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.4",
    "@types/pg": "^8.10.7",
    "@types/uuid": "^9.0.6",
    "@types/jest": "^29.5.6",
    "@types/supertest": "^2.0.15",
    "typescript": "^5.2.2",
    "ts-node": "^10.9.1",
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "supertest": "^6.3.3",
    "eslint": "^8.51.0",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "prettier": "^3.0.3",
    "husky": "^8.0.3",
    "lint-staged": "^14.0.1",
    "tsconfig-paths": "^4.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seu-usuario/hell-authenticator.git"
  },
  "bugs": {
    "url": "https://github.com/seu-usuario/hell-authenticator/issues"
  },
  "homepage": "https://github.com/seu-usuario/hell-authenticator#readme"
}
